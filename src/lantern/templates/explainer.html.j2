{% extends "base.html.j2" %}

{% block content %}
<div class="lantern-container">
  <!-- Explainer Hero -->
  <section class="lantern-hero">
    <div class="lantern-hero-split">
      <div>
        {% if badge %}
          <span class="lantern-badge">{{ badge }}</span>
        {% endif %}
        <h1 class="lantern-title">{{ title }}</h1>
        {% if subtitle %}
          <p class="lantern-subtitle">{{ subtitle }}</p>
        {% endif %}
        {% if author or date %}
          <div class="lantern-meta-bar">
            {% if author %}
              <div class="lantern-meta-item">
                <span>✍</span>
                <span>{{ author }}</span>
              </div>
            {% endif %}
            {% if date %}
              <div class="lantern-meta-item">
                <span>📅</span>
                <span>{{ date }}</span>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>

  <!-- Markdown Document Flow -->
  <article class="lantern-prose">
    {{ content | safe }}
  </article>
</div>
{% endblock %}
