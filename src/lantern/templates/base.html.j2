<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title | default("Lantern Explainer") }}</title>
  
  {# Favicon #}
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏮</text></svg>">

  {# Reading Progress Indicator Bar #}
  <div class="lantern-progress-bar"></div>

  {# KaTeX Math Assets #}
  {% if standalone %}
    <style>{{ katex_css | safe }}</style>
    <script>{{ katex_js | safe }}</script>
    <script>{{ katex_auto_render_js | safe }}</script>
  {% else %}
    <link rel="stylesheet" href="{{ static_prefix }}/katex/katex.min.css" />
    <script defer src="{{ static_prefix }}/katex/katex.min.js"></script>
    <script defer src="{{ static_prefix }}/katex/contrib/auto-render.min.js"></script>
  {% endif %}

  {# Plotly CDN if Plotly figure is embedded #}
  {% if has_plotly %}
    <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
  {% endif %}

  {# Lantern Obsidian Frost Stylesheet #}
  {% if standalone %}
    <style>{{ lantern_css | safe }}</style>
  {% else %}
    <link rel="stylesheet" href="{{ static_prefix }}/lantern.css" />
  {% endif %}

  {# Global Site CSS & Sibling Scoped CSS #}
  {% if extra_css_content %}
    <style id="lantern-extra-css">{{ extra_css_content | safe }}</style>
  {% endif %}
  {% if sibling_css %}
    <style id="lantern-sibling-css">{{ sibling_css | safe }}</style>
  {% endif %}

  {% block head_extra %}{% endblock %}

  {# Live Reload Script #}
  {% if live_reload %}
    <script id="__lantern_live_reload">
      (function() {
        const evtSource = new EventSource("/_lantern/events");
        evtSource.onmessage = function(e) {
          if (e.data === "reload") {
            console.log("[Lantern] File changed, reloading...");
            location.reload();
          }
        };
        evtSource.onerror = function() {
          setTimeout(() => {}, 1500);
        };
      })();
    </script>
  {% endif %}
</head>
<body>
  <!-- Header / Navigation -->
  <header class="lantern-nav">
    <div class="lantern-nav-left">
      <a href="{{ root_path | default('') }}index.html" class="lantern-brand">
        <span class="lantern-brand-icon">{{ brand_icon | default("🏮") }}</span>
        {% if not breadcrumbs %}
          <span>{{ brand | default(title | default("Lantern")) }}</span>
        {% endif %}
      </a>
      {% if breadcrumbs %}
        <nav class="lantern-breadcrumbs" aria-label="Breadcrumb">
          {% for crumb in breadcrumbs %}
            {% if not loop.first %}<span class="lantern-breadcrumb-sep">/</span>{% endif %}
            {% if crumb.url and not loop.last %}
              <a href="{{ crumb.url }}" class="lantern-breadcrumb-item">{{ crumb.title }}</a>
            {% else %}
              <span class="lantern-breadcrumb-item {% if loop.last %}active{% endif %}">{{ crumb.title }}</span>
            {% endif %}
          {% endfor %}
        </nav>
      {% endif %}
    </div>
    
    <div class="lantern-nav-meta">
      {% if snowpack_pdf %}
        {% set pdf_url = snowpack_pdf if snowpack_pdf.startswith(('http://', 'https://', '/')) else (root_path | default('')) ~ snowpack_pdf %}
        <a class="lantern-btn lantern-btn-primary lantern-btn-sm" href="{{ pdf_url }}" target="_blank">
          📄 Open Companion PDF Reader (Snowpack)
        </a>
      {% endif %}
    </div>
  </header>

  <!-- Floating Section Dot Navigation Rail -->
  {% if nav_dots is not defined or nav_dots %}
    <nav class="lantern-dot-nav" id="lantern-dot-nav" aria-label="Section Navigation"></nav>
  {% endif %}

  <!-- Main Content Layout -->
  <main class="lantern-main">
    {% block content %}{% endblock %}

    {% if prev_page or next_page %}
      <div class="lantern-container">
        <nav class="lantern-pagination" aria-label="Page Navigation">
          {% if prev_page %}
            <a href="{{ prev_page.url }}" class="lantern-page-nav-link lantern-page-nav-prev">
              <span class="lantern-page-nav-direction">← Previous</span>
              <span class="lantern-page-nav-title">{{ prev_page.title }}</span>
            </a>
          {% else %}
            <div class="lantern-page-nav-placeholder"></div>
          {% endif %}

          {% if next_page %}
            <a href="{{ next_page.url }}" class="lantern-page-nav-link lantern-page-nav-next">
              <span class="lantern-page-nav-direction">Next →</span>
              <span class="lantern-page-nav-title">{{ next_page.title }}</span>
            </a>
          {% else %}
            <div class="lantern-page-nav-placeholder"></div>
          {% endif %}
        </nav>
      </div>
    {% endif %}
  </main>

  <!-- Toast Notification Container -->
  <div class="lantern-toast-container"></div>

  <!-- Footer -->
  <footer class="lantern-footer">
    <div class="lantern-container">
      <p>Compiled with <strong>Lantern</strong> — Frost's Interactive Explainer & Simulation Compiler.</p>
      {% if footer %}<p style="margin-top: 0.3rem;">{{ footer }}</p>{% endif %}
      {% if author %}<p style="margin-top: 0.3rem;">{{ author }}</p>{% endif %}
      {% if date %}<p style="margin-top: 0.3rem;">{{ date }}</p>{% endif %}
    </div>
  </footer>

  {# Lantern Core Client Runtime #}
  {% if standalone %}
    <script>{{ lantern_js | safe }}</script>
  {% else %}
    <script src="{{ static_prefix }}/lantern.js"></script>
  {% endif %}

  {% block scripts_extra %}{% endblock %}
</body>
</html>
